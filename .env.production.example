APP_NAME="D'Tomate"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.d-tomates.com
APP_KEY=

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=dtomate
DB_USERNAME=dtomate_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=notifications@d-tomates.com
MAIL_FROM_NAME="D'Tomate"

DTOMATE_ALLOW_REGISTRATION=false
DTOMATE_TZ=Africa/Lubumbashi
DTOMATE_SEED_PASSWORD=
DTOMATE_SITE_ACCESS_CODE=

# Suivi quotidien — horaires du site (DTOMATE_TZ)
DTOMATE_TASK_SITE_CODE=NTETEMA
DTOMATE_TASK_DEADLINE=17:00
DTOMATE_TASK_MORNING=06:00
DTOMATE_TASK_AFTERNOON=14:00
DTOMATE_TASK_REVIEW=17:30
DTOMATE_TASK_REPORT=18:00

# Photos de preuve : conversion WebP, qualité 75–100 et côté maximum en pixels
DTOMATE_TASK_PHOTO_QUALITY=85
DTOMATE_TASK_PHOTO_MAX_EDGE=2560
